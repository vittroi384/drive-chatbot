# .env.example  — Git에 커밋되는 템플릿. 실제 비밀값은 절대 여기 넣지 말 것.
# 사용법(PowerShell, 프로젝트 루트에서):
#   Copy-Item .env.example .env
#   그 다음 아래 빈 값들을 채우기 (출처 주석 참고).

# --- Application ---
APP_NAME=Drive Chatbot
COMPANY_NAME=examplecorp
COMPANY_LOGO_URL=
SYSTEM_PROMPT=당신은 사내 문서 기반 어시스턴트입니다. 반드시 제공된 문서 내용에만 근거해 답변하고, 문서에 없는 내용은 절대 지어내지 마세요.
ENV=local

# --- GCP ---
GCP_PROJECT_ID=my-gcp-project
GCP_LOCATION=asia-northeast3
# 서비스 계정 키 경로. 비우면 ADC(GOOGLE_APPLICATION_CREDENTIALS 등) 사용.
GCP_CREDENTIALS_PATH=

# --- OAuth (출처: OAuth 클라이언트 JSON 의 web.*) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback
GOOGLE_DOMAIN=example.com
ALLOWED_EMAILS=
# 세션 서명 키: 로컬에서 직접 생성해 채우기 (예: PowerShell)
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# --- IAP (운영 전용) ---
# X-Goog-IAP-JWT-Assertion 검증용 audience. 형식: /projects/<PROJECT_NUMBER>/global/backendServices/<ID>
# 비우면 IAP 경로 비활성(세션만 사용). 로컬은 비워 둔다.
IAP_AUDIENCE=

# --- Vertex AI Search (출처: 데이터스토어 + 검색앱) ---
# DATA_STORE_ID: data store short id (예: my-docs-datastore_0000000000000)
# ENGINE_ID    : search app id        (예: drive-chatbot-search_1779696087733)
# 질의는 engine 경로 사용 (data store 직접 경로는 404).
VERTEX_DATA_STORE_ID=
VERTEX_ENGINE_ID=
VERTEX_SEARCH_TARGET=engine
VERTEX_SERVING_CONFIG=default_serving_config
VERTEX_LOCATION=global

# --- Gemini ---
# gemini-1.5-* / 2.0-* 사용 불가(신규 프로젝트). gemini-3-flash 는 Vertex 미존재(404).
# Vertex 라이브인 gemini-2.5-flash 사용(2026-10-16 은퇴, 베타 기간 커버). 모델명은 한 줄로 교체.
GEMINI_MODEL=gemini-2.5-flash

# --- Search backend (vertex | oauth | hybrid) ---
SEARCH_MODE=hybrid

# --- GCS (실제 버킷명은 전세계 유일성 위해 프로젝트번호 suffix 포함) ---
# 패턴: my-gcp-project-docs-<PROJECT_NUMBER>  (실제 값은 .env 에만)
GCS_DOCS_BUCKET=my-gcp-project-docs-PROJECT_NUMBER

# --- Firestore ---
FIRESTORE_DATABASE=(default)

# --- Rate limit ---
RATE_LIMIT_PER_MINUTE=5
